<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Claymorphism Dark Palette (Deep Midnight Navy + Royal Blue + Vibrant Orange) -->
    
    <!-- Window Background (SolidColorBrush for test compatibility + Gradient for Web Parity) -->
    <Color x:Key="WindowBackgroundColor">#0F1117</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />

    <!-- Window Background Gradient -->
    <LinearGradientBrush x:Key="WindowGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#090D16" Offset="0.0" />
        <GradientStop Color="#0F172A" Offset="0.55" />
        <GradientStop Color="#18120C" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Header -->
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0B0F19" />
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#1E293B" />

    <!-- Clay Cards (#141926 with soft borders) -->
    <Color x:Key="CardBackgroundColor">#141926</Color>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />

    <Color x:Key="CardHoverBackgroundColor">#1B2233</Color>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="{StaticResource CardHoverBackgroundColor}" />

    <Color x:Key="CardBorderColor">#1E293B</Color>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />

    <Color x:Key="CardSubtleBorderColor">#1B2233</Color>
    <SolidColorBrush x:Key="CardSubtleBorderBrush" Color="{StaticResource CardSubtleBorderColor}" />

    <!-- Clay Wells (Recessed textareas and glyph bays) -->
    <Color x:Key="InputBackgroundColor">#0C101C</Color>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="ClayWellBackgroundBrush" Color="#0C101C" />
    <SolidColorBrush x:Key="ClayWellBorderBrush" Color="#1E293B" />

    <!-- Clay Rotor Bay (#101524) -->
    <SolidColorBrush x:Key="ClayBayBackgroundBrush" Color="#101524" />
    <SolidColorBrush x:Key="ClayBayBorderBrush" Color="#1E293B" />

    <!-- Royal Blue Accents -->
    <Color x:Key="PrimaryAccentColor">#3B82F6</Color>
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}" />

    <Color x:Key="PrimaryAccentHoverColor">#2563EB</Color>
    <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="{StaticResource PrimaryAccentHoverColor}" />

    <LinearGradientBrush x:Key="PrimaryAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0.0" />
        <GradientStop Color="#1D4ED8" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Vibrant Orange Accents -->
    <Color x:Key="SecondaryAccentColor">#F97316</Color>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccentColor}" />

    <Color x:Key="OrangeAccentColor">#F97316</Color>
    <SolidColorBrush x:Key="OrangeAccentBrush" Color="{StaticResource OrangeAccentColor}" />

    <LinearGradientBrush x:Key="OrangeAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F97316" Offset="0.0" />
        <GradientStop Color="#EA580C" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Clay Pills / Badges -->
    <LinearGradientBrush x:Key="ClayPillBlueBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E3A8A" Offset="0.0" />
        <GradientStop Color="#1E40AF" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ClayPillBlueTextBrush" Color="#93C5FD" />

    <LinearGradientBrush x:Key="ClayPillOrangeBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C2D12" Offset="0.0" />
        <GradientStop Color="#9A3412" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ClayPillOrangeTextBrush" Color="#FDBA74" />

    <!-- Typography Colors -->
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />

    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <Color x:Key="TextMutedColor">#64748B</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="TextBrandBlueBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="TextBrandOrangeBrush" Color="#FB923C" />

    <!-- Statuses -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

    <Color x:Key="WarningColor">#F59E0B</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <Color x:Key="WarningBackground">#2E2211</Color>
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource WarningBackground}" />

    <!-- ComboBox Theme Brushes (DARK FIXED) -->
    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="#0C101C" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#2A344A" />
    <SolidColorBrush x:Key="ComboBoxForegroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="ComboBoxPopupBackgroundBrush" Color="#141926" />
    <SolidColorBrush x:Key="ComboBoxItemHoverBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="ComboBoxItemSelectedBrush" Color="#EA580C" />
    <SolidColorBrush x:Key="ComboBoxItemSelectedTextBrush" Color="#FFFFFF" />

</ResourceDictionary>
