<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fallback Defaults (matches Light Claymorphism) -->
    
    <Color x:Key="WindowBackgroundColor">#F1F5F9</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />

    <LinearGradientBrush x:Key="WindowGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EFF6FF" Offset="0.0" />
        <GradientStop Color="#F1F5F9" Offset="0.55" />
        <GradientStop Color="#FFF7ED" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#DBEAFE" />

    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />

    <Color x:Key="CardHoverBackgroundColor">#F8FAFC</Color>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="{StaticResource CardHoverBackgroundColor}" />

    <Color x:Key="CardBorderColor">#E2E8F0</Color>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />

    <Color x:Key="CardSubtleBorderColor">#DBEAFE</Color>
    <SolidColorBrush x:Key="CardSubtleBorderBrush" Color="{StaticResource CardSubtleBorderColor}" />

    <Color x:Key="InputBackgroundColor">#F8FAFC</Color>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="ClayWellBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="ClayWellBorderBrush" Color="#DBEAFE" />

    <SolidColorBrush x:Key="ClayBayBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="ClayBayBorderBrush" Color="#E2E8F0" />

    <Color x:Key="PrimaryAccentColor">#1D4ED8</Color>
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}" />

    <Color x:Key="PrimaryAccentHoverColor">#1E40AF</Color>
    <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="{StaticResource PrimaryAccentHoverColor}" />

    <LinearGradientBrush x:Key="PrimaryAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0.0" />
        <GradientStop Color="#1D4ED8" Offset="1.0" />
    </LinearGradientBrush>

    <Color x:Key="SecondaryAccentColor">#EA580C</Color>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccentColor}" />

    <Color x:Key="OrangeAccentColor">#F97316</Color>
    <SolidColorBrush x:Key="OrangeAccentBrush" Color="{StaticResource OrangeAccentColor}" />

    <LinearGradientBrush x:Key="OrangeAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F97316" Offset="0.0" />
        <GradientStop Color="#EA580C" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ClayPillBlueBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DBEAFE" Offset="0.0" />
        <GradientStop Color="#BFDBFE" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ClayPillBlueTextBrush" Color="#1E40AF" />

    <LinearGradientBrush x:Key="ClayPillOrangeBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFEDD5" Offset="0.0" />
        <GradientStop Color="#FED7AA" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ClayPillOrangeTextBrush" Color="#C2410C" />

    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />

    <Color x:Key="TextSecondaryColor">#475569</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <Color x:Key="TextMutedColor">#64748B</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="TextBrandBlueBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="TextBrandOrangeBrush" Color="#EA580C" />

    <Color x:Key="SuccessColor">#059669</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

    <Color x:Key="WarningColor">#D97706</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <Color x:Key="WarningBackground">#FEF3C7</Color>
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource WarningBackground}" />

    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="ComboBoxForegroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="ComboBoxPopupBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxItemHoverBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="ComboBoxItemSelectedBrush" Color="#EA580C" />
    <SolidColorBrush x:Key="ComboBoxItemSelectedTextBrush" Color="#FFFFFF" />

</ResourceDictionary>
