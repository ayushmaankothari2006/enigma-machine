# Supabase Project Configuration
# Get these values from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Cloudflare Turnstile Site Key (public sitekey from Cloudflare Dashboard -> Turnstile)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA_your_turnstile_site_key
